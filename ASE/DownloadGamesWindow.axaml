<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        xmlns:models="clr-namespace:ASE.Models"
        mc:Ignorable="d"
        x:Class="ASE.DownloadGamesWindow"
        Title="Download Games &amp; Demos"
        Classes="aseDialog"
        Width="920" Height="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              Margin="24,20,24,14"
              ColumnSpacing="14">

            <Border Classes="dialogHeaderIcon">
                <Svg Path="avares://ASE/Assets/Icons/collection-fill.svg"
                     Width="22"
                     Height="22"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                <TextBlock Classes="windowTitle"
                           Text="Download Games &amp; Demos"/>
                <TextBlock Classes="description"
                           Text="Download curated public domain classics, search Internet Archive retro libraries, or paste a custom disk image link."/>
            </StackPanel>
        </Grid>

        <!-- Search and Filter Bar -->
        <Border Grid.Row="1"
                Classes="card"
                Margin="24,0,24,12"
                Padding="12,10">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <!-- Tabs / Source selection -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <RadioButton x:Name="TabCurated" Content="Curated Classics" IsChecked="True"
                                 GroupName="SourceGroup" IsCheckedChanged="OnSourceTabChanged"/>
                    <RadioButton x:Name="TabTosec" Content="TOSEC Archive"
                                 GroupName="SourceGroup" IsCheckedChanged="OnSourceTabChanged"/>
                    <RadioButton x:Name="TabArchive" Content="Internet Archive Search"
                                 GroupName="SourceGroup" IsCheckedChanged="OnSourceTabChanged"/>
                    <RadioButton x:Name="TabDirect" Content="Direct Link"
                                 GroupName="SourceGroup" IsCheckedChanged="OnSourceTabChanged"/>
                </StackPanel>

                <!-- Filter / Search input -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" x:Name="SearchPanel">
                    <TextBox x:Name="TextSearch"
                             PlaceholderText="Search games by title (e.g. Oxyd, Lemmings, Pinball)..."
                             KeyDown="OnSearchKeyDown"/>
                    <Button Grid.Column="1" Classes="compact accent" Content="Search" Click="OnSearchClick" x:Name="ButtonSearch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Svg Path="avares://ASE/Assets/Icons/search.svg" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center">Search</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Direct Link Input Panel -->
                <StackPanel Grid.Row="1" Spacing="8" x:Name="DirectLinkPanel" IsVisible="False">
                    <TextBlock Classes="fieldLabel" Text="Disk Image or Archive URL (.st, .msa, .zip)"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="TextDirectUrl"
                                 PlaceholderText="https://example.com/games/mygame.zip"/>
                        <Button Grid.Column="1" Classes="compact accent" Content="Download" Click="OnDownloadDirectClick"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Games List Content Area -->
        <Border Grid.Row="2"
                Classes="card"
                Margin="24,0,24,12"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <!-- Loading indicator -->
                <StackPanel x:Name="LoadingPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10"
                            IsVisible="False">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="Fetching games..." HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>

                <!-- Empty or Status Message -->
                <TextBlock x:Name="EmptyText"
                           Text="No games found. Try another search query."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           FontSize="15"
                           IsVisible="False"/>

                <!-- Games ListBox -->
                <ListBox x:Name="GamesList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadableGame">
                            <Border Background="#242424"
                                    BorderBrush="#383838"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <!-- Icon / Disk marker -->
                                    <Border Grid.Column="0"
                                            Width="44" Height="44"
                                            CornerRadius="6"
                                            Background="#333333"
                                            VerticalAlignment="Center">
                                        <Svg Path="avares://ASE/Assets/Icons/disk.svg"
                                             Width="22" Height="22"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"/>
                                            <Border Background="#142B38"
                                                    BorderBrush="#00D2FF"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10"
                                                           Foreground="#00D2FF"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Year}"
                                                       FontSize="12"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Author}"
                                                       FontSize="11"
                                                       Opacity="0.5"/>
                                            <TextBlock Text="{Binding Size}"
                                                       FontSize="11"
                                                       Opacity="0.5"
                                                       IsVisible="{Binding Size, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="11"
                                                       Foreground="#00D2FF"
                                                       Opacity="0.8"/>
                                        </StackPanel>

                                        <!-- Progress bar when downloading -->
                                        <ProgressBar Value="{Binding Progress}"
                                                     Maximum="100"
                                                     Height="4"
                                                     Margin="0,4,0,0"
                                                     IsVisible="{Binding IsDownloading}"/>
                                        <TextBlock Text="{Binding StatusMessage}"
                                                   FontSize="11"
                                                   Foreground="#00D2FF"
                                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <!-- Action Button -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <Button Classes="compact"
                                                Classes.accent="{Binding CanDownload}"
                                                Content="{Binding StatusButtonText}"
                                                IsEnabled="{Binding !IsDownloading}"
                                                Click="OnGameActionClick"
                                                MinWidth="90"
                                                HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact"
                                                Content="Play"
                                                IsVisible="{Binding IsInstalled}"
                                                Click="OnPlayGameClick"
                                                MinWidth="90"
                                                HorizontalContentAlignment="Center"/>
                                        <Button Classes="compact"
                                                Content="Uninstall"
                                                IsVisible="{Binding IsInstalled}"
                                                Click="OnUninstallGameClick"
                                                MinWidth="90"
                                                HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Footer / Bottom bar -->
        <Grid Grid.Row="3"
              Margin="24,0,24,18"
              ColumnDefinitions="*,Auto"
              VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="description" Text="Library: "/>
                <TextBlock x:Name="TextLibraryPath" Classes="description" Text="Not configured" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="compact"
                    Content="Close"
                    Click="OnCloseClick"
                    MinWidth="80"/>
        </Grid>

    </Grid>
</Window>
